ADMIN_USERNAME=replace-with-a-private-admin-name
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

SITE_STORAGE_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=site-media

# Optional for local filesystem mode only. Omit this in the Supabase production setup.
SITE_DATA_DIR=./site-data
